generator client {
  provider = "prisma-client"
  output   = "../src/repo/prisma-client"
}

datasource db {
  provider = "postgresql"
}

model Profile {
  userId         String  @id
  userName       String  @unique @db.VarChar(255)
  coins          Int     @default(0)
  stash          Item[]
  ships          Ship[]  @relation("OwnedShips")
  selectedShipId String? @unique
  selectedShip   Ship?   @relation("SelectedShip", fields: [selectedShipId], references: [id], onDelete: SetNull)
}

model Item {
  id        String
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [userId], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  quantity  Int

  @@id([profileId, id])
}

model Ship {
  id         String   @id @default(uuid())
  shipId     String
  profileId  String
  profile    Profile  @relation("OwnedShips", fields: [profileId], references: [userId], onDelete: Cascade)
  selectedBy Profile? @relation("SelectedShip")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
